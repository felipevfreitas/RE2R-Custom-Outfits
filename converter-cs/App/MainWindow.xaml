<Window x:Class="CustomOutfits.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wardrobe Converter" Icon="Assets/app.ico" Width="1040" Height="760" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" AllowDrop="True"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- part tag (Body / Face / Hair) -->
    <Style x:Key="PartBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="#2A2A31" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Part}" Value="body"><Setter Property="Background" Value="#2EC8102E" /></DataTrigger>
        <DataTrigger Binding="{Binding Part}" Value="face"><Setter Property="Background" Value="#2E4682DC" /></DataTrigger>
        <DataTrigger Binding="{Binding Part}" Value="hair"><Setter Property="Background" Value="#29E1A526" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PartText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#D6D6DE" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Part}" Value="body"><Setter Property="Foreground" Value="#FF8A98" /></DataTrigger>
        <DataTrigger Binding="{Binding Part}" Value="face"><Setter Property="Foreground" Value="#8DB8FF" /></DataTrigger>
        <DataTrigger Binding="{Binding Part}" Value="hair"><Setter Property="Foreground" Value="#F2C66B" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Storyboard x:Key="Spin" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="SpinRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8" />
    </Storyboard>

    <!-- character group (list of parts) -->
    <DataTemplate x:Key="GroupTemplate">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" ClipToBounds="True">
        <StackPanel>
          <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10" CornerRadius="10,10,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PartBadge}">
                      <TextBlock Text="{Binding PartLabel}" Style="{StaticResource PartText}" />
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Meta}" Margin="0,8,0,0" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="P" Margin="0,0,6,4" Padding="9,2" CornerRadius="10" Background="#26262D" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPill}" Value="False">
                              <Setter TargetName="P" Property="Background" Value="Transparent" />
                              <Setter TargetName="P" Property="BorderThickness" Value="0" />
                              <Setter TargetName="P" Property="Padding" Value="0,3,6,2" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.Background>
      <RadialGradientBrush Center="0.2,-0.1" GradientOrigin="0.2,-0.1" RadiusX="0.75" RadiusY="0.6">
        <GradientStop Color="#24151A" Offset="0" />
        <GradientStop Color="#121214" Offset="1" />
      </RadialGradientBrush>
    </Grid.Background>

    <!-- start: drop the mods -->
    <ScrollViewer x:Name="EmptyView" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24">
      <StackPanel MaxWidth="900">
        <Grid x:Name="DropZone" MinHeight="320">
          <Rectangle x:Name="DropBorder" RadiusX="16" RadiusY="16" Stroke="#3A3A44" StrokeThickness="2" StrokeDashArray="4 3" Fill="#991B1B1F" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,48">
            <Image Source="Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Drop skin mods here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text=".zip · .rar · .7z · or folders  —  one or many at once" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
              <Button Content="Open files" Style="{StaticResource BtnPrimary}" Click="OpenFile_Click" Margin="0,0,10,0" />
              <Button Content="Open folder" Style="{StaticResource Btn}" Click="OpenFolder_Click" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" Foreground="{StaticResource Muted}" MaxWidth="620" Margin="0,18,0,0"
                   Text="The converter moves each mod to its own folder so it no longer replaces the original outfit. Install the result in Fluffy Mod Manager and pick it in game from the costume menu (RE2) or the REFramework menu (Wardrobe)." />
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12">
          <Run Text="Game folders:" Foreground="{StaticResource Muted}" />
          <Hyperlink x:Name="GameLink2" Tag="re2" Click="ChooseGame_Click" Foreground="{StaticResource Muted}">Resident Evil 2</Hyperlink>
          <Run Text="·" Foreground="{StaticResource Muted}" />
          <Hyperlink x:Name="GameLink3" Tag="re3" Click="ChooseGame_Click" Foreground="{StaticResource Muted}">Resident Evil 3</Hyperlink>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>

    <!-- loaded mods: names -->
    <ScrollViewer x:Name="PlanView" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
      <StackPanel MaxWidth="900">
        <DockPanel Margin="2,0,2,14">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Add mods" Style="{StaticResource BtnSmall}" Click="AddMods_Click" Margin="0,0,8,0" />
            <Button Content="Start over" Style="{StaticResource BtnSmall}" Click="StartOver_Click" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ModsTitle" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Outfit names are shown in the in-game menu. Edit them if you want." Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>

        <ItemsControl x:Name="Mods">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#0FFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,18">
                <StackPanel>
                  <DockPanel Margin="2,0,2,10">
                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource BtnSmall}" Click="RemoveMod_Click" Tag="{Binding}"
                            Visibility="{Binding RemoveVisibility}" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="MOD" Style="{StaticResource Label}" />
                      <TextBlock Text="{Binding FileName}" ToolTip="{Binding Input}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,12,0" />
                    </StackPanel>
                  </DockPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                      <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6">
                        <Run Text="MOD NAME" /><Run Text="  (shown in Fluffy Mod Manager)" />
                      </TextBlock>
                      <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Visibility="{Binding PictureVisibility}">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="112" Height="112" CornerRadius="6" Background="#16FFFFFF" Margin="0,0,14,0"
                              Visibility="{Binding PreviewVisibility}" ClipToBounds="True">
                        <Image Source="{Binding PicturePreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Use default" Style="{StaticResource BtnSmall}" Click="DefaultPicture_Click" Tag="{Binding}"
                                Visibility="{Binding DefaultPictureVisibility}" Margin="0,0,8,0" />
                        <Button Content="Choose image…" Style="{StaticResource BtnSmall}" Click="ChoosePicture_Click" Tag="{Binding}" />
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PICTURE IN THE GAME'S COSTUME MENU" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PictureText}" TextWrapping="Wrap" FontSize="13" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" />
                  <Border Style="{StaticResource Card}" Background="#221D12" BorderBrush="#5A4415" Visibility="{Binding WarningsVisibility}" Margin="0">
                    <StackPanel>
                      <TextBlock Text="Warnings" Foreground="{StaticResource Warn}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding WarningsText}" Foreground="#E6D3A8" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- result -->
    <ScrollViewer x:Name="DoneView" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" MaxWidth="900" Padding="24,40">
        <StackPanel HorizontalAlignment="Center">
          <Border Width="58" Height="58" CornerRadius="29" Background="#262FBF71" HorizontalAlignment="Center">
            <Path Data="m5 12.5 4.5 4.5L19 7.5" Stroke="{StaticResource Ok}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Width="30" Height="30" Stretch="Uniform" />
          </Border>
          <TextBlock x:Name="DoneTitle" Text="Mod converted" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
          <TextBlock x:Name="DoneText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,8" />
          <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <TextBox x:Name="DonePath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="Show in folder" Style="{StaticResource BtnPrimary}" Click="ShowFile_Click" Margin="0,0,10,0" />
            <Button Content="Convert more" Style="{StaticResource Btn}" Click="Another_Click" />
          </StackPanel>
          <TextBlock Text="Install them in Fluffy Mod Manager and keep the original (replacing) mods disabled." Foreground="{StaticResource Muted}"
                     FontSize="12.5" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- action bar -->
    <Border x:Name="Actions" Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14" Background="#F2121214" Visibility="Collapsed">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveOverButton" Content="Save over original" Style="{StaticResource BtnDanger}" Click="SaveOver_Click" Margin="0,0,10,0" />
          <Button x:Name="SaveNewButton" Content="Save as new mod" Style="{StaticResource BtnPrimary}" Click="SaveNew_Click" />
        </StackPanel>
        <TextBlock x:Name="Summary" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- busy -->
    <Grid x:Name="Busy" Grid.RowSpan="2" Background="#B80A0A0C" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid Width="44" Height="44" HorizontalAlignment="Center">
          <Ellipse Stroke="#3A3A44" StrokeThickness="4" />
          <Path Stroke="{StaticResource Accent2}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M22,2 A20,20 0 0 1 42,22" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><RotateTransform x:Name="SpinRotate" /></Path.RenderTransform>
          </Path>
        </Grid>
        <TextBlock x:Name="BusyText" Text="Working..." HorizontalAlignment="Center" Margin="0,16,0,0" />
      </StackPanel>
    </Grid>

    <!-- temporary notice -->
    <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="40,0,40,84"
            Background="#2A1418" BorderBrush="#6B2531" BorderThickness="1" CornerRadius="8" Padding="16,10" Visibility="Collapsed" MaxWidth="760">
      <TextBlock x:Name="ToastText" Foreground="#FFD5DB" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
